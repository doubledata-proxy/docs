{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "DoubleData API",
  "colors": {
    "primary": "#006C49",
    "light": "#007C55",
    "dark": "#8DF0BF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "url": "full",
    "examples": {
      "languages": ["curl", "javascript", "go", "python"],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart", "authentication"]
      },
      {
        "group": "Workflows",
        "pages": ["guides/ordering", "guides/rotations", "guides/ip-authorization", "errors"]
      },
      {
        "group": "API reference",
        "openapi": "openapi.json",
        "pages": [
          "api-reference/introduction",
          "GET /balance",
          "GET /isp/catalog",
          "POST /isp/quotes",
          "POST /isp/orders",
          "GET /isp/orders/{orderId}",
          "GET /isp/subscriptions",
          "DELETE /isp/subscriptions/{subscriptionId}",
          "GET /isp/subscriptions/{subscriptionId}/proxies",
          "POST /isp/subscriptions/{subscriptionId}/rotations",
          "GET /isp/rotations/{rotationId}",
          "GET /isp/subscriptions/{subscriptionId}/ip-authorization",
          "PUT /isp/subscriptions/{subscriptionId}/ip-authorization",
          "DELETE /isp/subscriptions/{subscriptionId}/ip-authorization"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.proxy.doubledata.com/dashboard"
    }
  },
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "perplexity", "mcp", "cursor", "vscode"]
  }
}
