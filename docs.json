{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Double Data Proxy Docs",
  "colors": {
    "primary": "#006C49",
    "light": "#007C55",
    "dark": "#8DF0BF"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "url": "full",
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "go",
        "python"
      ],
      "defaults": "required",
      "prefill": true,
      "autogenerate": true
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart",
          "authentication"
        ]
      },
      {
        "group": "Proxy connections",
        "pages": [
          "guides/proxy-formats",
          "guides/sticky-sessions"
        ]
      },
      {
        "group": "Workflows",
        "pages": [
          "guides/usage",
          "guides/ordering",
          "guides/rotations",
          "guides/ip-authorization",
          "errors"
        ]
      },
      {
        "group": "API reference",
        "openapi": "openapi.json",
        "pages": [
          "api-reference/introduction",
          {
            "group": "All proxies",
            "pages": [
              "api-reference/usage",
              "GET /balance"
            ]
          },
          {
            "group": "Residential",
            "pages": [
              "api-reference/residential"
            ]
          },
          {
            "group": "Datacenter",
            "pages": [
              "api-reference/datacenter"
            ]
          },
          {
            "group": "Mobile",
            "pages": [
              "api-reference/mobile"
            ]
          },
          {
            "group": "ISP",
            "pages": [
              "api-reference/isp",
              {
                "group": "Catalog and orders",
                "pages": [
                  "GET /isp/catalog",
                  "POST /isp/quotes",
                  "POST /isp/orders",
                  "GET /isp/orders/{orderId}"
                ]
              },
              {
                "group": "Subscriptions",
                "pages": [
                  "GET /isp/subscriptions",
                  "GET /isp/subscriptions/{subscriptionId}/proxies",
                  "DELETE /isp/subscriptions/{subscriptionId}"
                ]
              },
              {
                "group": "Rotations",
                "pages": [
                  "POST /isp/subscriptions/{subscriptionId}/rotations",
                  "GET /isp/rotations/{rotationId}"
                ]
              },
              {
                "group": "IP authorization",
                "pages": [
                  "GET /isp/subscriptions/{subscriptionId}/ip-authorization",
                  "PUT /isp/subscriptions/{subscriptionId}/ip-authorization",
                  "DELETE /isp/subscriptions/{subscriptionId}/ip-authorization"
                ]
              }
            ]
          }
        ]
      },
      {
        "group": "Proxy SDK",
        "pages": [
          "sdk/overview",
          "sdk/downloads",
          "sdk/mobile",
          "sdk/desktop",
          "sdk/consent"
        ]
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.proxy.doubledata.com/dashboard"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "interaction": {
    "drilldown": false
  }
}
